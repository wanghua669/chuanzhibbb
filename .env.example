# ============================================================================
# CyberTwin Box (赛博伴生：成长型数字人分身箱庭系统) - 环境变量模板
# 10分钟极速复现说明：
# 1. 复制本文件为 .env (或者直接在软件右上角「API 大脑配置中心」图形界面中填写)
# 2. 即使不填写 API Key，系统内置的「本地启发式混合认知引擎」也可 100% 离线运行全部功能！
# ============================================================================

# 大语言模型接口配置 (兼容 OpenAI / DeepSeek / 通义千问 Qwen / SiliconFlow 等)
VITE_LLM_API_KEY=your_api_key_here_leave_blank_for_offline_mode
VITE_LLM_BASE_URL=https://api.deepseek.com/v1
VITE_LLM_MODEL=deepseek-chat

# 视觉多模态大模型接口配置 (用于摄像头高阶环境理解，按需触发，可选)
VITE_VLM_API_KEY=your_vision_api_key_here
VITE_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITE_VLM_MODEL=qwen-vl-plus

# 应用默认参数
VITE_HEARTBEAT_INTERVAL_SEC=25
VITE_DEFAULT_PARALLAX_INTENSITY=1.0
